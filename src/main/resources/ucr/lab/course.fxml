<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="bp" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #23c3ff;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CourseController">
    <center>
        <AnchorPane prefHeight="615.0" prefWidth="804.0">
            <children>
                <Pane layoutX="-3.0" prefHeight="86.0" prefWidth="806.0" style="-fx-background-color: #fe6962;">
                    <children>
                        <Label layoutX="90.0" layoutY="20.0" text="Courses List (Doubly Linked List)">
                            <font>
                                <Font name="Arial" size="40.0" />
                            </font>
                        </Label>
                    </children>
                </Pane>
                <Pane layoutX="-3.0" layoutY="86.0" prefHeight="367.0" prefWidth="806.0" style="-fx-background-color: #23c3ff;">
                    <children>
                        <TableView fx:id="courseTableview" layoutX="15.0" layoutY="14.0" prefHeight="350.0" prefWidth="761.0">
                            <columns>
                                <TableColumn fx:id="idTableColumn" prefWidth="115.19995498657227" text="Id" />
                                <TableColumn fx:id="nameTableColumn" prefWidth="349.7999725341797" text="Name" />
                                <TableColumn fx:id="creditsTableColumn" prefWidth="272.800048828125" text="Credits" />
                            </columns>
                        </TableView>
                    </children>
                </Pane>
                <Pane layoutY="462.0" prefHeight="154.0" prefWidth="806.0" style="-fx-background-color: #76c497;">
                    <children>
                        <ButtonBar layoutX="1.0" layoutY="14.0" nodeOrientation="RIGHT_TO_LEFT" prefHeight="40.0" prefWidth="761.0">
                            <buttons>
                                <Button layoutX="202.0" layoutY="17.0" mnemonicParsing="false" onAction="#sizeOnAction" text="Size" />
                                <Button layoutX="685.0" layoutY="17.0" mnemonicParsing="false" onAction="#containsOnAction" text="Contains" />
                                <Button layoutX="135.0" layoutY="17.0" mnemonicParsing="false" onAction="#addSortedOnAction" text="Add Sorted" />
                                <Button layoutX="135.0" layoutY="17.0" mnemonicParsing="false" onAction="#addFirstOnAction" text="Add First" />
                                <Button mnemonicParsing="false" onAction="#addOnAction" text="Add" />
                            </buttons>
                        </ButtonBar>
                        <ButtonBar layoutY="57.0" nodeOrientation="RIGHT_TO_LEFT" prefHeight="40.0" prefWidth="761.0">
                            <buttons>
                                <Button layoutX="202.0" layoutY="17.0" mnemonicParsing="false" onAction="#clearOnAction" text="Clear" />
                                <Button layoutX="125.0" layoutY="17.0" mnemonicParsing="false" onAction="#removeFirstOnAction" text="Remove First" />
                                <Button layoutX="525.0" layoutY="17.0" mnemonicParsing="false" onAction="#removeOnAction" text="Remove" />
                                <Button layoutX="104.0" layoutY="17.0" mnemonicParsing="false" onAction="#getLastOnAction" text="Get Last" />
                                <Button mnemonicParsing="false" onAction="#getFirstOnAction" text="Get First" />
                            </buttons>
                        </ButtonBar>
                    </children>
                </Pane>
            </children>
        </AnchorPane>
    </center>
</BorderPane>
