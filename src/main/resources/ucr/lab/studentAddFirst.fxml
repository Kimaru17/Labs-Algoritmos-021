<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="bp" prefHeight="591.0" prefWidth="747.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.StudentAddFirstController">

    <center>
        <Pane prefHeight="463.0" prefWidth="749.0" style="-fx-background-color: #23c3ff;" BorderPane.alignment="CENTER">
            <children>
                <Label layoutX="157.0" layoutY="149.0" text="Student ID:">
                    <font>
                        <Font name="Times New Roman" size="20.0" />
                    </font>
                </Label>
                <Label layoutX="157.0" layoutY="217.0" text="Name (first and last):">
                    <font>
                        <Font name="Times New Roman" size="20.0" />
                    </font>
                </Label>
                <Label layoutX="157.0" layoutY="281.0" text="Age:">
                    <font>
                        <Font name="Times New Roman" size="20.0" />
                    </font>
                </Label>
                <Label layoutX="157.0" layoutY="336.0" text="Address:">
                    <font>
                        <Font name="Times New Roman" size="20.0" />
                    </font>
                </Label>
                <TextField fx:id="tf_studentId" layoutX="338.0" layoutY="141.0" prefHeight="39.0" prefWidth="161.0" />
                <TextField fx:id="tf_name" layoutX="338.0" layoutY="208.0" prefHeight="41.0" prefWidth="268.0" />
                <TextField fx:id="tf_age" layoutX="338.0" layoutY="276.0" prefHeight="33.0" prefWidth="71.0" />
                <TextField fx:id="tf_address" layoutX="338.0" layoutY="336.0" prefHeight="62.0" prefWidth="273.0" />
                <Pane layoutY="489.0" prefHeight="102.0" prefWidth="749.0" style="-fx-background-color: #76c497;">
                    <children>
                        <Button layoutX="139.0" layoutY="14.0" mnemonicParsing="false" onAction="#addOnAction" prefHeight="57.0" prefWidth="114.0" text="Add">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Button>
                        <Button layoutX="318.0" layoutY="15.0" mnemonicParsing="false" onAction="#cleanOnAction" prefHeight="57.0" prefWidth="114.0" text="Clean">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Button>
                        <Button layoutX="495.0" layoutY="14.0" mnemonicParsing="false" onAction="#closeOnAction" prefHeight="57.0" prefWidth="114.0" text="Close">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Button>
                    </children>
                </Pane>
                <Pane prefHeight="121.0" prefWidth="749.0" style="-fx-background-color: #fe6962;">
                    <children>
                        <Label layoutX="156.0" layoutY="37.0" text="Add Students (Add First)">
                            <font>
                                <Font name="Arial" size="40.0" />
                            </font>
                        </Label>
                    </children>
                </Pane>
            </children>
        </Pane>
    </center>
</BorderPane>
