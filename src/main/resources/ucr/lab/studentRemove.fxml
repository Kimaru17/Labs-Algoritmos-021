<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.StudentRemoveController"
            prefHeight="400.0" prefWidth="600.0">
    <center>
        <Pane prefHeight="463.0" prefWidth="749.0" style="-fx-background-color: #77B0AA;" BorderPane.alignment="CENTER">
            <children>
                <Label layoutX="222.0" layoutY="221.0" text="Student ID:">
                    <font>
                        <Font name="Times New Roman" size="20.0" />
                    </font>
                </Label>
                <TextField fx:id="tf_studentId" layoutX="398.0" layoutY="220.0" />
                <Pane layoutY="489.0" prefHeight="102.0" prefWidth="749.0" style="-fx-background-color: #f8b068;">
                    <children>
                        <Button layoutX="139.0" layoutY="14.0" mnemonicParsing="false" onAction="#removeOnAction" prefHeight="57.0" prefWidth="114.0" text="Remove">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Button>
                        <Button layoutX="318.0" layoutY="15.0" mnemonicParsing="false" onAction="#cleanOnAction" prefHeight="57.0" prefWidth="114.0" text="Clean">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Button>
                        <Button layoutX="495.0" layoutY="14.0" mnemonicParsing="false" onAction="#closeOnAction" prefHeight="57.0" prefWidth="114.0" text="Close">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Button>
                    </children>
                </Pane>
                <Pane prefHeight="121.0" prefWidth="749.0" style="-fx-background-color: #003C43;">
                    <children>
                        <Label layoutX="255.0" layoutY="42.0" text="Remove Student" textFill="#fff7f7">
                            <font>
                                <Font name="Times New Roman" size="32.0" />
                            </font>
                        </Label>
                    </children>
                </Pane>
                <Label layoutX="178.0" layoutY="152.0" text="Enter the id of the student you want to remove:">
                    <font>
                        <Font name="Times New Roman" size="20.0" />
                    </font>
                </Label>
            </children>
        </Pane>
    </center>
</BorderPane>