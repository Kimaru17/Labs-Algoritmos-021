<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="bp" prefHeight="591.0" prefWidth="747.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RegisterAddController">
    <center>
        <Pane prefHeight="463.0" prefWidth="749.0" style="-fx-background-color: #B2DFDB;" BorderPane.alignment="CENTER">
            <children>
                <Label layoutX="154.0" layoutY="148.0" text="Register ID:">
                    <font>
                        <Font name="Arial" size="20.0" />
                    </font>
                </Label>
                <Label layoutX="154.0" layoutY="216.0" text="Date:">
                    <font>
                        <Font name="Arial" size="20.0" />
                    </font>
                </Label>
                <Label layoutX="154.0" layoutY="280.0" text="Select a student:">
                    <font>
                        <Font name="Arial" size="20.0" />
                    </font>
                </Label>
                <Label layoutX="154.0" layoutY="352.0" text="Select a course:">
                    <font>
                        <Font name="Arial" size="20.0" />
                    </font>
                </Label>

                <TextField fx:id="tf_registerId" layoutX="306.0" layoutY="142.0" prefHeight="37.0" prefWidth="58.0" />
            <DatePicker fx:id="date" layoutX="306.0" layoutY="210.0" prefHeight="36.0" prefWidth="151.0" />
            <ChoiceBox fx:id="studentCB" layoutX="307.0" layoutY="276.0" prefHeight="37.0" prefWidth="395.0" />
            <ChoiceBox fx:id="courseCB" layoutX="307.0" layoutY="345.0" prefHeight="37.0" prefWidth="394.0" />
                <Pane layoutY="489.0" prefHeight="102.0" prefWidth="747.0" style="-fx-background-color: #4DB6AC;">
                    <children>
                        <Button layoutX="139.0" layoutY="14.0" mnemonicParsing="false" onAction="#addOnAction" prefHeight="57.0" prefWidth="114.0" text="Add">
                            <font>
                                <Font name="Arial" size="18.0" />
                            </font>
                        </Button>
                        <Button layoutX="318.0" layoutY="15.0" mnemonicParsing="false" onAction="#cleanOnAction" prefHeight="57.0" prefWidth="114.0" text="Clean">
                            <font>
                                <Font name="Arial" size="18.0" />
                            </font>
                        </Button>
                        <Button layoutX="495.0" layoutY="14.0" mnemonicParsing="false" onAction="#closeOnAction" prefHeight="57.0" prefWidth="114.0" text="Close">
                            <font>
                                <Font name="Arial" size="18.0" />
                            </font>
                        </Button>
                    </children>
                </Pane>
                <Pane prefHeight="121.0" prefWidth="747.0" style="-fx-background-color: #00796B;">
                    <children>
                        <Label layoutX="281.0" layoutY="42.0" text="Add Register">
                            <font>
                                <Font name="Arial" size="40.0" />
                            </font>
                        </Label>
                    </children>
                </Pane>
            </children>
        </Pane>
    </center>
</BorderPane>
